<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>404 Not Found | Balanced Bite</title>
    <link rel="stylesheet" href="/styles/auth.css">
</head>
<body class="dashboard-error-body">

<div class="dashboard-error-layout">

    <aside class="error-sidebar">
        <div class="sidebar-brand">Balanced Bite</div>

        <nav class="error-nav">
            <a href="/">Dashboard</a>
            <a href="/mealplans">Meal Plans</a>
            <a href="/meals">Meals</a>
            <a href="/subscriptions">Subscriptions</a>
            <a href="/login">Login</a>
        </nav>
    </aside>

    <main class="error-main">
        <header class="error-topbar">
            <div>
                <h1>Page Not Found</h1>
                <p>The page you requested could not be located.</p>
            </div>
        </header>

        <section class="error-dashboard-card">
            <div class="error-badge">404</div>

            <h2>This page is off the menu 🍽️</h2>

            <p>
                The link may be broken, the page may have moved, or the route may not exist yet.
            </p>

            <div class="error-actions">
                <a href="/" class="primary-action">Go to Dashboard</a>
                <a href="/login" class="secondary-action">Back to Login</a>
            </div>
        </section>
    </main>

</div>

</body>
</html>